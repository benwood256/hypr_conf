local vars = require("variables")
local fn = require("utils.functions")

-----------------------------------------------------------
-- Caelestia / Shell
-----------------------------------------------------------

hl.bind("SUPER + SUPER_L", hl.dsp.global("caelestia:launcher"), {
    release = true
})

local cael = {
    session      = "caelestia:session",
    sidebar      = "caelestia:sidebar",
    clearNotifs  = "caelestia:clearNotifs",
    panels       = "caelestia:showall",
    lock         = "caelestia:lock",
}

hl.bind(vars.kbSession, hl.dsp.global(cael.session))
hl.bind(vars.kbShowSidebar, hl.dsp.global(cael.sidebar))
hl.bind(vars.kbClearNotifs, hl.dsp.global(cael.clearNotifs), { locked = true })
hl.bind(vars.kbShowPanels, hl.dsp.global(cael.panels))
hl.bind(vars.kbLock, hl.dsp.global(cael.lock))

hl.bind(vars.kbRestoreLock, function()
    hl.dispatch(hl.dsp.exec_cmd("caelestia shell -d"))
    hl.dispatch(hl.dsp.global(cael.lock))
end)


-----------------------------------------------------------
-- Brightness / Media
-----------------------------------------------------------

hl.bind("XF86MonBrightnessUp",
    hl.dsp.global("caelestia:brightnessUp"),
    { locked = true }
)

hl.bind("XF86MonBrightnessDown",
    hl.dsp.global("caelestia:brightnessDown"),
    { locked = true }
)


local media = {
    toggle = "caelestia:mediaToggle",
    next   = "caelestia:mediaNext",
    prev   = "caelestia:mediaPrev",
    stop   = "caelestia:mediaStop",
}

for _, key in ipairs({
    "XF86AudioPlay",
    "XF86AudioPause",
    "CTRL + SUPER + Space"
}) do
    hl.bind(key, hl.dsp.global(media.toggle), { locked = true })
end

for _, key in ipairs({
    "XF86AudioNext",
    "CTRL + SUPER + Equal"
}) do
    hl.bind(key, hl.dsp.global(media.next), { locked = true })
end

for _, key in ipairs({
    "XF86AudioPrev",
    "CTRL + SUPER + Minus"
}) do
    hl.bind(key, hl.dsp.global(media.prev), { locked = true })
end

hl.bind("XF86AudioStop", hl.dsp.global(media.stop), {
    locked = true
})


-----------------------------------------------------------
-- Restart / Reload
-----------------------------------------------------------

hl.bind(
    "CTRL + SUPER + SHIFT + R",
    hl.dsp.exec_cmd("qs -c caelestia kill"),
    { release = true }
)

hl.bind(
    "CTRL + SUPER + ALT + R",
    hl.dsp.exec_cmd(
        "qs -c caelestia kill; sleep .1; caelestia shell -d"
    ),
    { release = true }
)


-----------------------------------------------------------
-- Window movement
-----------------------------------------------------------

hl.bind(
    "SUPER + mouse:272",
    hl.dsp.window.drag(),
    { mouse = true }
)

hl.bind(
    "SUPER + mouse:273",
    hl.dsp.window.resize(),
    { mouse = true }
)


hl.bind(vars.kbToggleWindowFloating,
    hl.dsp.window.float()
)

hl.bind(vars.kbWindowBorderedFullscreen,
    hl.dsp.window.fullscreen({
        mode = "maximized"
    })
)


------------------
-- WORKSPACES ---
------------------

-- Focus workspace
for i = 1, 9 do
    hl.bind(
        "SUPER + " .. i,
        hl.dsp.focus({ workspace = i })
    )
end

-- Move window to workspace
for i = 1, 9 do
    hl.bind(
        "SUPER + SHIFT + " .. i,
        hl.dsp.window.move({ workspace = i })
    )
end

-----------------------------------------------------------
-- Window navigation
-----------------------------------------------------------

local focus = {
    ["U"] = "left",
    ["I"] = "down",
    ["O"] = "up",
    ["P"] = "right",
}

for key, direction in pairs(focus) do
    hl.bind(
        "SUPER + " .. key,
        hl.dsp.focus({
            direction = direction
        })
    )
end


local move = {
    ["M"] = "left",
    ["Comma"] = "down",
    ["Period"] = "up",
    ["Slash"] = "right",
}

for key, direction in pairs(move) do
    hl.bind(
        "SUPER + " .. key,
        hl.dsp.window.move({
            direction = direction
        })
    )
end

